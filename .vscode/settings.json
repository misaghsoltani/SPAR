  // ========== LINTING & FORMATTING ==========
  "ruff.configurationPreference": "filesystemFirst",
  "ruff.lint.enable": true,
  "ruff.fixAll": true,
  "ruff.importStrategy": "fromEnvironment",
  "ruffRulesExplainer.showDecorations": true,
  "ruff.lineLength": 120,
  "ruff.exclude": [
    "**/.pixi/",
    "**/outputs/",
    "**/logs/",
    "**/checkpoints/",
    "**/slurm_run_outputs/",
    "spar/offline_data/",
    "**/.git/",
    "**/.venv/",
    "**/node_modules/",
    "**/bower_components/",
    "**/.mypy_cache/",
    "**/.pytest_cache/",
    "**/.DS_Store/",
    "**/.ruff_cache/",
    "**/*.egg-info/",
    "**/build/",
    "**/dist/"
  ],
  // "ruff.nativeServer": "on",
