{
  // ========== PYTHON CONFIGURATION ==========
  "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/dev/bin/python",
  // "python.envFile": "${workspaceFolder}/.env",
  "pixi-vscode.defaultChannels": ["conda-forge"],
  "pixi-vscode.defaultProjectType": "pixi",
  "pixi-code.pixiExecutable": "pixi",
  "python-envs.defaultEnvManager": "ms-python.python:system",
  "python.pixiToolPath": "pixi",
  "latex-workshop.latex.tools": [
    {
      "name": "spar-latexmk",
      "command": "pixi",
      "args": [
        "run",
        "-e",
        "dev",
        "latexmk",
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-halt-on-error",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "SPAR: compile paper",
      "tools": ["spar-latexmk"]
    },
    {
      "name": "SPAR: compile standalone TikZ figure",
      "tools": ["spar-latexmk"]
    }
  ],
  // ========== TESTING CONFIGURATION ==========
  // "python.testing.pytestPath": "${workspaceFolder}/.pixi/envs/test/bin/pytest",
  // "python.testing.pytestEnabled": true,
